&inputepw
  prefix      = 'cdo'
  amass(1) = 112.411,
  amass(2) = 15.9994,
  outdir      = './'
  dvscf_dir   = './save'

  elph        = .true.
  epwwrite    = .false.
  epwread     = .true.
  lpolar      = .true.
  vme         = 'wannier'
  use_ws      = .true.
  mp_mesh_k   = .true.

  wannierize  = .false.
  nbndsub     =  8
  bands_skipped = 'exclude_bands = 1-5'
  num_iter    = 1000
  proj(1)     = 'Cd:l=2'
  proj(2)     = 'O:l=1'
  dis_froz_max = 12.0
  dis_win_max = 12.0

  scattering = .true.
  scattering_serta = .true.
  int_mob = .false.
  carrier = .true.
  ncarrier = -1E13
  iterative_bte = .true.
  epmatkqread = .false.
  mob_maxiter = 10
  broyden_beta = 1.0
  
  nstemp = 1
  temps  = 300

  restart = .true.
  restart_step = 50

  fsthick = 0.3
  degaussw = 0.0

  efermi_read = .true.
  fermi_energy = 11.5475
  !fermi_energy = 12.3731

  nkf1  = 20 
  nkf2  = 20
  nkf3  = 20
  nqf1  = 20
  nqf2  = 20
  nqf3  = 20

  nk1   = 4 
  nk2   = 4
  nk3   = 4
  nq1   = 2
  nq2   = 2
  nq3   = 2
/

