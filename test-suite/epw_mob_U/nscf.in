 &control
   calculation  = 'nscf',
   restart_mode = 'from_scratch',
   prefix       = 'cdo',
   pseudo_dir   = '../../pseudo/',
   outdir       = './',
   verbosity    = 'high'
   disk_io      = 'low',
/
 &system
   ibrav = 2, 
   celldm(1) = 8.915
   nat = 2, 
   ntyp = 2, 
   nbnd = 20 
   ecutwfc = 60, 
 /
 &electrons
   diagonalization = 'david',
   diago_full_acc  = .true.,
   conv_thr        =  1.0D-10,
   mixing_beta     =  0.7,
 /
 ATOMIC_SPECIES
   Cd   0.000   Cd_ONCV_PBE_SR.upf
   O    0.000   O_ONCV_PBE_SR.upf
