# BAD: a conditional <units> whose last <case> still carries a "test"
# (the last case of a conditional units/dimensionality must be a testless
# fallback, exactly as for a conditional <default>).
input_description -distribution {Quantum ESPRESSO} -package TEST -program test.x {
    card ATOMIC_POSITIONS {

        flag atompos_unit -use optional {
            enum { alat | bohr }
            default { alat }
        }

        syntax {
            table positions {
                rows -start 1 -end nat {
                    col x -type REAL {
                        dimensionality { length }
                        units -kind conditional {
                            case -test "atompos_unit == 'alat'" { alat }
                            case -test "atompos_unit == 'bohr'" { bohr }
                        }
                        info { first cartesian coordinate of the atom }
                    }
                }
            }
        }
    }
}
